<script>
    LokiComponentExtender.extend('LokiCheckoutComponent', 'ZipCodeMaskMixin', () => {
        return {
            zipCodeMask(input) {
                const digits = input.replace(/\D/g, '');

                return digits.length > 5
                    ? '99999-9999'
                    : '99999';
            }
        }
    }, {when: component => component.fieldName === 'postcode'});
</script>
